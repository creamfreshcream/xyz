# ---------------------------------------------------------------- Jellyfin ---
# Where the music comes from. The URL must be reachable from the radio host.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
# Only needed for favourites and named playlists (Dashboard -> Users -> <user>, see URL).
JELLYFIN_USER_ID=

# -------------------------------------------------------------------- Music ---
# direct = Liquidsoap decodes the original file (no load on Jellyfin).
# transcode = Jellyfin transcodes first; use it if bandwidth to Jellyfin is tight.
RADIO_STREAM_MODE=direct
RADIO_MAX_BITRATE=320000
RADIO_TRANSCODE_CODEC=mp3

# ------------------------------------------------------------------------ DJ ---
# The DJ picks targets by daypart mood and reads AudioMuse-AI's own Postgres
# database directly for that — same credentials the audiomuse-ai stack itself
# uses (docker exec audiomuse-ai-flask-app env | grep POSTGRES). AudioMuse-AI
# and this radio must be on the same docker network for this to resolve.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=audiomuse
POSTGRES_PASSWORD=
POSTGRES_DB=audiomusedb
# Everything below has a sensible default in dj.py — only uncomment to tune it.
# DJ_LOOKAHEAD_TRACKS=6       # keep at least this many tracks queued ahead
# DJ_LOOP_INTERVAL=60         # seconds between top-up checks
# DJ_BRIDGE_MAX_TRACKS=14     # cap on tracks used to sonically bridge to a new target
# DJ_THEMED_BRIDGE_MAX_TRACKS=4  # same, but for a themed daypart (artists/genres/tags) -- keeps a time-boxed theme hour from spending itself bridging
# DJ_DWELL_TRACKS=6           # tracks spent lingering near a target before picking the next
# DJ_RECENT_TRACK_HOURS=3     # don't repeat a track within this window
# DJ_RECENT_ARTIST_MINUTES=45 # don't repeat an artist within this window
# DJ_STATUS_PORT=9090
# DJ_PLAYLIST_NAME=DJ: on air now  # kept in sync as a real Jellyfin playlist
# DJ_PLAYLIST_SYNC_MINUTES=10      # how often it's refreshed
# DJ_PLAYLIST_MAX_TRACKS=30        # most recent N tracks it holds

# ------------------------------------------------------------------ Station ---
RADIO_NAME=Jellyfin Radio
RADIO_DESCRIPTION=Streaming straight from my Jellyfin library
RADIO_GENRE=Various
RADIO_URL=https://radio.example.com
RADIO_MOUNT=/stream.mp3
RADIO_BITRATE=128
# Optional second, higher quality mount.
RADIO_HQ_ENABLED=false
RADIO_HQ_MOUNT=/stream-hq.mp3
RADIO_HQ_BITRATE=320
# Seconds of crossfade between tracks (0 disables it) and loudness levelling.
RADIO_CROSSFADE=3
RADIO_NORMALIZE=false
# Drop station IDs into ./jingles and play one every N tracks (0 disables).
RADIO_JINGLES_DIR=/jingles
RADIO_JINGLE_EVERY=0

# ------------------------------------------------------------------ Live DJ ---
RADIO_HARBOR_PORT=8005
RADIO_HARBOR_MOUNT=live
RADIO_HARBOR_PASSWORD=change-me-too
RADIO_HARBOR_FADE=2

# ------------------------------------------------------------------ Icecast ---
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me-as-well
ICECAST_HOSTNAME=radio.example.com
ICECAST_MAX_LISTENERS=200
ICECAST_LOCATION=Falkenstein
ICECAST_ADMIN_EMAIL=you@example.com

# -------------------------------------------------------------------- Caddy ---
# Your domain (A/AAAA record pointing at the Hetzner box) for automatic HTTPS,
# or ":80" to run without TLS while testing.
RADIO_DOMAIN=radio.example.com

LOG_LEVEL=INFO
