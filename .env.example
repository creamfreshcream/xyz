# ---- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: comma-separated guild IDs. Commands sync instantly to these servers.
# Leave empty to register commands globally (can take up to an hour to appear).
DISCORD_GUILD_IDS=

# ---- Jellyfin --------------------------------------------------------------
JELLYFIN_URL=http://jellyfin.local:8096

# Either an API key (Dashboard > API Keys) ...
JELLYFIN_API_KEY=

# ... or a username + password (a dedicated, read-only-ish account is nice).
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# Optional: which Jellyfin user's library/favourites to use. Auto-detected
# when possible; required if an admin API key maps to several users.
JELLYFIN_USER_ID=

# ---- Playback tuning -------------------------------------------------------
# true  = stream the original file and let ffmpeg decode it (best quality, no
#         load on the Jellyfin server)
# false = ask Jellyfin to transcode to AAC first (useful for exotic codecs)
JELLYFIN_DIRECT_STREAM=true
JELLYFIN_MAX_BITRATE=320000

# Report playback to Jellyfin so it shows a session and counts plays.
JELLYFIN_REPORT_PLAYBACK=true

DEFAULT_VOLUME=50
MAX_QUEUE_LENGTH=500
# Seconds to wait with an empty queue before leaving the voice channel.
IDLE_TIMEOUT=300
SEARCH_LIMIT=25

LOG_LEVEL=INFO
