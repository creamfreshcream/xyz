# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Secret used to sign session cookies and stream tokens.
# Generate with:  openssl rand -hex 32
RADIO_SECRET_KEY=change-me-openssl-rand-hex-32
# Public base URL of this app - used to build the tuner URLs shown in the hub.
RADIO_BASE_URL=http://localhost:8000
RADIO_PORT=8000
RADIO_LOG_LEVEL=INFO

# Bootstrap admin account (created on first start only).
RADIO_ADMIN_USERNAME=admin
RADIO_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Jellyfin (music source)
# ---------------------------------------------------------------------------
RADIO_JELLYFIN_URL=http://jellyfin:8096
RADIO_JELLYFIN_API_KEY=your-jellyfin-api-key
# Optional: pin a user id. Empty = first available user is used.
RADIO_JELLYFIN_USER_ID=
# Optional: restrict to one music library (Jellyfin ParentId).
RADIO_JELLYFIN_LIBRARY_ID=
# Report playback to Jellyfin so play counts / "last played" stay accurate.
RADIO_JELLYFIN_REPORT_PLAYBACK=true

# ---------------------------------------------------------------------------
# AudioMuse-AI (BPM / key / energy / mood / similarity -> smart crossfade)
# ---------------------------------------------------------------------------
RADIO_AUDIOMUSE_ENABLED=true
RADIO_AUDIOMUSE_URL=http://audiomuse:8000
RADIO_AUDIOMUSE_API_KEY=
# Endpoint paths are configurable because AudioMuse deployments differ.
# {id} is replaced with the Jellyfin item id.
RADIO_AUDIOMUSE_TRACK_PATH=/api/track/{id}
RADIO_AUDIOMUSE_SIMILAR_PATH=/api/similar_tracks
RADIO_AUDIOMUSE_SEARCH_PATH=/api/search_tracks

# ---------------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------------
RADIO_SAMPLE_RATE=44100
RADIO_DEFAULT_BITRATE=192
# Seconds of encoded audio sent to a client on connect so playback starts fast.
RADIO_PREBUFFER_SECONDS=3
# Global cap; a station can lower it via its own stream spec.
RADIO_MAX_LISTENERS_PER_STATION=50

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
RADIO_SESSION_TTL_HOURS=720
RADIO_STREAM_TOKEN_TTL_HOURS=8760
# Allow HTTP Basic on /stream/* so classic radio players (VLC, Sonos, ...) work.
RADIO_ALLOW_BASIC_AUTH=true
# Set true only behind HTTPS.
RADIO_COOKIE_SECURE=false
